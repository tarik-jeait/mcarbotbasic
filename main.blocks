<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="LYN1_fz`V^5{5aCvLFWY" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="$=2(v5K]ZBA+K65q{FMC"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace MCarBotBasic {" line1="" line2="    export enum Dir {" line3="        Forward = 1," line4="        Backward = 2" line5="    };" line6="    export enum Led {" line7="        Right = 1," line8="        Left = 2," line9="        All = 3" line10="    };" line11="    export enum Motor {" line12="        Right = 1," line13="        Left = 2," line14="        All = 3" line15="    };" line16="" line17="    //% blockId=mcarbot_init" line18="    //% block=&quot;McarBot Init&quot;" line19="    //% group=&quot;General&quot;" line20="    export function McarBotInit() {" line21="        i2cWriteCommand(1, 1, 0, 0, 0, 0, 0, 0);" line22="    }" line23="    //% block='McarBot Reset'" line24="    //% group='General'" line25="    export function McarBotReset() {" line26="        // i2cWriteCommand(1, 2, 0, 0, 0, 0, 0, 0);" line27="        pins.digitalWritePin(DigitalPin.P0, 0)" line28="        basic.pause(100)" line29="        pins.digitalWritePin(DigitalPin.P0, 1)" line30="" line31="    }" line32="    //% block='LED:$led R:$red G:$green B:$blue'" line33="    //% inlineInputMode=inline" line34="    //% red.defl=1" line35="    //% red.min=0 red.max=1" line36="    //% green.defl=1" line37="    //% green.min=0 green.max=1" line38="    //% blue.defl=1" line39="    //% blue.min=0 blue.max=1" line40="    //% group='RGB LED'" line41="    export function setLed(led: Led, red: number, green: number, blue: number) {" line42="        i2cWriteCommand(10, led as number, red, green, blue, 0, 0, 0);" line43="        // let i2cReadBuffer = i2cReadCommand();" line44="        // return i2cReadBuffer.getNumber(NumberFormat.UInt8LE, 2);" line45="    }" line46="    let LF_Sensor_Left = 0;" line47="    let LF_Sensor_Right = 0;" line48="    //% block=&quot;LF Left&quot;" line49="    //% group='Line Follower'" line50="    export function getLfLeft() {" line51="        return LF_Sensor_Left" line52="    }" line53="    //% block=&quot;LF Right&quot;" line54="    //% group='Line Follower'" line55="    export function getLfRight() {" line56="        return LF_Sensor_Right" line57="    }" line58="    //% block=&quot;Calibrate LF Sensors&quot;" line59="    //% group='Line Follower'" line60="    export function calibrateLfSensors() {" line61="        i2cWriteCommand(30, 1, 0, 0, 0, 0, 0, 0);" line62="        let i2cReadBuffer2 = i2cReadCommand();" line63="        // i2cReadCommand();" line64="    }" line65="    //% block=&quot;Read LF Sensors&quot;" line66="    //% group='Line Follower'" line67="    export function readLfSensors() {" line68="        i2cWriteCommand(30, 2, 0, 0, 0, 0, 0, 0);" line69="        let i2cReadBuffer_sensors = i2cReadCommand();" line70="        LF_Sensor_Left = i2cReadBuffer_sensors.getNumber(NumberFormat.UInt8LE, 0);" line71="        LF_Sensor_Right = i2cReadBuffer_sensors.getNumber(NumberFormat.UInt8LE, 1);" line72="        // return i2cReadBuffer[2];" line73="    }" line74="    //% block='Set Motor:$motor Dir:$dir Speed:$speed'" line75="    //% speed.defl=100" line76="    //% speed.min=0 speed.max=100" line77="    //% group='Moves'" line78="    export function setMotor(motor: Motor, dir: Dir, speed: number): void {" line79="        i2cWriteCommand(20, motor as number, speed, dir as number, 0, 0, 0, 0);" line80="        // let i2cReadBuffer_motors_start = i2cReadCommand();" line81="    }" line82="    //% block = &quot;Stop Motors&quot;" line83="    //% group='Moves'" line84="    export function StopMotors() {" line85="        i2cWriteCommand(20, 4, 0, 0, 0, 0, 0, 0);" line86="        //let i2cReadBuffer_motors_stop = i2cReadCommand();" line87="    }" line88="    //% block='Set Left Wheel Speed:$leftSpeed Right Wheel Speed:$rightSpeed'" line89="    //% leftSpeed.defl=100" line90="    //% leftSpeed.min=-100 leftSpeed.max=100" line91="    //% rightSpeed.defl=100" line92="    //% rightSpeed.min=-100 rightSpeed.max=100    " line93="    //% group='Moves'" line94="    export function setSpeed(leftSpeed: number, rightSpeed: number): void {" line95="        let left_direction = Dir.Forward" line96="        let right_direction = Dir.Forward" line97="" line98="        let left_speed = 0" line99="        let right_speed = 0" line100="" line101="        if (leftSpeed &gt;= 0) {" line102="            left_direction = Dir.Forward" line103="            left_speed = leftSpeed" line104="        } else {" line105="            left_direction = Dir.Backward" line106="            left_speed = leftSpeed * -1" line107="        }" line108="        if (rightSpeed &gt;= 0) {" line109="            right_direction = Dir.Forward" line110="            right_speed = rightSpeed" line111="        } else {" line112="            right_direction = Dir.Backward" line113="            right_speed = rightSpeed * -1" line114="        }" line115="        i2cWriteCommand(20, 5, left_speed, left_direction as number, right_speed, right_direction as number, 0, 0);" line116="        //let i2cReadBuffer_speed_start = i2cReadCommand();" line117="    }" line118="    // note that Caml casing yields lower case" line119="    // block text with spaces" line120="    export function getRpAddress() {" line121="        let rp_address = 0x13;" line122="        return rp_address;" line123="    }" line124="    function i2cWriteCommand(commandId: number, subCommandId: number, arg1: number, arg2: number, arg3: number, arg4: number, arg5: number, arg6: number) {" line125="        let writeCommandBuffer = pins.createBuffer(6);" line126="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 0, commandId);" line127="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 1, subCommandId);" line128="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 2, arg1);" line129="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 3, arg2);" line130="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 4, arg3);" line131="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 5, arg4);" line132="        //writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 6, arg5);" line133="        //writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 7, arg6);" line134="        pins.i2cWriteBuffer(getRpAddress(), writeCommandBuffer, false);" line135="    }" line136="    function i2cReadCommand() {" line137="        return pins.i2cReadBuffer(getRpAddress(), 2, false);" line138="    }" line139="}" numlines="140"></mutation></block></statement></block></xml>