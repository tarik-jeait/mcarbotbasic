<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="^){Qpj2pK/?.Lq~JLtBi" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="+/q5YkEqXt}SO!S7Nt4B"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace MCarBotBasic {" line1="" line2="    export enum Dir {" line3="        Forward = 0," line4="        Backward = 1" line5="    }" line6="    //% blockId=mcarbot_init" line7="    //% block=&quot;McarBot Init&quot;" line8="    //% group=&quot;General&quot;" line9="    export function McarBotInit() {" line10="        sendI2cWriteCommand(1, 1, 0, 0, 0, 0, 0, 0);" line11="    }" line12="    //% block='McarBot Reset'" line13="    //% group='General'" line14="    export function McarBotReset() {" line15="        sendI2cWriteCommand(2, 1, 0, 0, 0, 0, 0, 0);" line16="    }" line17="    //% block='Left Led R:$red G:$green B:$blue'" line18="    //% red.defl=255" line19="    //% red.min=0 red.max=255" line20="    //% green.defl=255" line21="    //% green.min=0 green.max=255" line22="    //% blue.defl=255" line23="    //% blue.min=0 blue.max=255" line24="    //% group='RGB LED'" line25="    export function LeftLed(red: number, green: number, blue: number) {" line26="        sendI2cWriteCommand(11, 1, red, green, blue, 0, 0, 0);" line27="    }" line28="" line29="    //% block='RLed R:$rred G:$rgreen B:$rblue|LLed R:$lred G:$lgreen B:$lblue'" line30="    //% inlineInputMode=inline" line31="    //% rred.defl=255" line32="    //% rred.min=0 rred.max=255" line33="    //% rgreen.defl=255" line34="    //% rgreen.min=0 rgreen.max=255" line35="    //% rblue.defl=255" line36="    //% rblue.min=0 rblue.max=255" line37="    //% lred.defl=255" line38="    //% lred.min=0 lred.max=255" line39="    //% lgreen.defl=255" line40="    //% lgreen.min=0 lgreen.max=255" line41="    //% lblue.defl=255" line42="    //% lblue.min=0 lblue.max=255    " line43="    //% group='RGB LED'" line44="    export function BothLeds(rred: number, rgreen: number, rblue: number, lred: number, lgreen: number, lblue: number) {" line45="        sendI2cWriteCommand(13, 1, rred, rgreen, rblue, lred, lgreen, lblue);" line46="    }" line47="    //% block='Right Led R:$red G:$green B:$blue'" line48="    //% red.defl=255" line49="    //% red.min=0 red.max=255" line50="    //% green.defl=255" line51="    //% green.min=0 green.max=255" line52="    //% blue.defl=255" line53="    //% blue.min=0 blue.max=255" line54="    //% group='RGB LED'" line55="    export function Rightled(red: number, green: number, blue: number) {" line56="        sendI2cWriteCommand(12, 1, red, green, blue, 0, 0, 0);" line57="    }" line58="" line59="    //% block='Get LF Sensors'" line60="    //% group='Line Follower'" line61="    export function getSensors() {" line62="        sendI2cWriteCommand(101, 0, 0, 0, 0, 0, 0, 0);" line63="        basic.pause(100);" line64="        // Read" line65="        let buffer = receiveI2cData();" line66="    }" line67="    //% block='Calibrate LF Sensors'" line68="    //% group='Line Follower'" line69="    export function calibrateSensors() {" line70="        sendI2cWriteCommand(102, 0, 0, 0, 0, 0, 0, 0);" line71="        basic.pause(100);" line72="        // Read" line73="        let buffer2 = receiveI2cData();" line74="    }" line75="    //% block = &quot;Start Motors&quot;" line76="    //% group='Moves'" line77="    export function StartMotors() {" line78="        sendI2cWriteCommand(21, 1, 0, 0, 0, 0, 0, 0);" line79="    }" line80="    //% block = &quot;Stop Motors&quot;" line81="    //% group='Moves'" line82="    export function StopMotors() {" line83="        sendI2cWriteCommand(22, 1, 0, 0, 0, 0, 0, 0);" line84="    }" line85="    //% block = &quot;Left Motor Dir:$dir Speed:$speed&quot;" line86="    //% speed.defl=100" line87="    //% speed.min=0 speed.max=100" line88="    //% group='Moves'" line89="    export function LeftMotor(dir: Dir, speed: number): void {" line90="        sendI2cWriteCommand(23, 1, speed, dir, 0, 0, 0, 0);" line91="    }" line92="    //% block = &quot;Right Motor Dir:$dir Speed:$speed&quot;" line93="    //% speed.defl=100" line94="    //% speed.min=0 speed.max=100" line95="    //% group='Moves'" line96="    export function RightMotor(dir: Dir, speed: number): void {" line97="        sendI2cWriteCommand(24, 1, speed, dir, 0, 0, 0, 0);" line98="    }" line99="" line100="    // note that Caml casing yields lower case" line101="    // block text with spaces" line102="    export function getRpAddress() {" line103="        let rp_address = 0x13;" line104="        return rp_address;" line105="    }" line106="    function sendI2cWriteCommand(commandId: number, commandType: number, arg1: number, arg2: number, arg3: number, arg4: number, arg5: number, arg6: number) {" line107="        let writeCommandBuffer = pins.createBuffer(8);" line108="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 0, commandId);" line109="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 1, commandType);" line110="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 2, arg1);" line111="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 3, arg2);" line112="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 4, arg3);" line113="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 5, arg4);" line114="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 6, arg5);" line115="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 7, arg6);" line116="        pins.i2cWriteBuffer(getRpAddress(), writeCommandBuffer, false);" line117="    }" line118="" line119="    function receiveI2cData() {" line120="        let receivedBuffer = pins.i2cReadBuffer(getRpAddress(), 8, false);" line121="        return receivedBuffer;" line122="    }" line123="" line124="}" numlines="125"></mutation></block></statement></block></xml>