<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="VOH2i::loF~M+W)2@ZIi" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="c]M]%EdFH7]bvg{-!TSU"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace MCarBotBasic {" line1="    export enum Dir {" line2="        Forward = 1," line3="        Backward = 2" line4="    };" line5="    export enum Led {" line6="        Right = 1," line7="        Left = 2," line8="        All = 3" line9="    };" line10="    export enum Motor {" line11="        Right = 1," line12="        Left = 2," line13="        All = 3" line14="    };" line15="    //% blockId=mcarbot_init" line16="    //% block=&quot;McarBot Init&quot;" line17="    //% group=&quot;General&quot;" line18="    export function McarBotInit() {" line19="        i2cWriteCommand(1, 1, 0, 0, 0, 0, 0, 0);" line20="    }" line21="    //% block='McarBot Reset'" line22="    //% group='General'" line23="    export function McarBotReset() {" line24="        i2cWriteCommand(1, 2, 0, 0, 0, 0, 0, 0);" line25="    }" line26="    //% block='LED:$led R:$red G:$green B:$blue'" line27="    //% inlineInputMode=inline" line28="    //% red.defl=1" line29="    //% red.min=0 red.max=1" line30="    //% green.defl=1" line31="    //% green.min=0 green.max=1" line32="    //% blue.defl=1" line33="    //% blue.min=0 blue.max=1" line34="    //% group='RGB LED'" line35="    export function setLed(led: Led, red: number, green: number, blue: number) {" line36="        i2cWriteCommand(10, led as number, red, green, blue, 0, 0, 0);" line37="        let i2cReadBuffer = i2cReadCommand();" line38="        return i2cReadBuffer.getNumber(NumberFormat.UInt8LE, 2);" line39="    }" line40="    //% block=&quot;Calibrate LF Sensors&quot;" line41="    //% group='Line Follower'" line42="    export function calibrateLfSensors() {" line43="        i2cWriteCommand(30, 1, 0, 0, 0, 0, 0, 0);" line44="        // i2cReadCommand();" line45="    }" line46="    //% block=&quot;Read LF Sensors&quot;" line47="    //% group='Line Follower'" line48="    export function readLfSensors() {" line49="        i2cWriteCommand(30, 2, 0, 0, 0, 0, 0, 0);" line50="        // let i2cReadBuffer = i2cReadCommand();" line51="        // return i2cReadBuffer[2];" line52="    }" line53="    //% block='Set Motor:$motor Dir:$dir Speed:$speed'" line54="    //% speed.defl=100" line55="    //% speed.min=0 speed.max=100" line56="    //% group='Moves'" line57="    export function setMotor(motor: Motor, dir: Dir, speed: number): void {" line58="        i2cWriteCommand(20, motor as number, speed, dir as number, 0, 0, 0, 0);" line59="    }" line60="    //% block = &quot;Stop Motors&quot;" line61="    //% group='Moves'" line62="    export function StopMotors() {" line63="        i2cWriteCommand(20, 2, 0, 0, 0, 0, 0, 0);" line64="    }" line65="    // note that Caml casing yields lower case" line66="    // block text with spaces" line67="    export function getRpAddress() {" line68="        let rp_address = 0x13;" line69="        return rp_address;" line70="    }" line71="    function i2cWriteCommand(commandId: number, subCommandId: number, arg1: number, arg2: number, arg3: number, arg4: number, arg5: number, arg6: number) {" line72="        let writeCommandBuffer = pins.createBuffer(8);" line73="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 0, commandId);" line74="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 1, subCommandId);" line75="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 2, arg1);" line76="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 3, arg2);" line77="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 4, arg3);" line78="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 5, arg4);" line79="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 6, arg5);" line80="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 7, arg6);" line81="        pins.i2cWriteBuffer(getRpAddress(), writeCommandBuffer, false);" line82="    }" line83="    function i2cReadCommand() {" line84="        return pins.i2cReadBuffer(getRpAddress(), 8, false);" line85="    }" line86="}" numlines="87"></mutation></block></statement></block></xml>