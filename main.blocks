<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="!^[.GV|2DX7dC5(Di{==" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="z~s2Y88]1IwBkt-BRK09"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace MCarBotBasic {" line1="    export enum Dir {" line2="        Forward = 1," line3="        Backward = 2" line4="    };" line5="    export enum Led {" line6="        Right = 1," line7="        Left = 2," line8="        All = 3" line9="    };" line10="    export enum Motor {" line11="        Right = 1," line12="        Left = 2," line13="        All = 3" line14="    };" line15="    //% blockId=mcarbot_init" line16="    //% block=&quot;McarBot Init&quot;" line17="    //% group=&quot;General&quot;" line18="    export function McarBotInit() {" line19="        i2cWriteCommand(1, 1, 0, 0, 0, 0, 0, 0);" line20="    }" line21="    //% block='McarBot Reset'" line22="    //% group='General'" line23="    export function McarBotReset() {" line24="        // i2cWriteCommand(1, 2, 0, 0, 0, 0, 0, 0);" line25="        pins.digitalWritePin(DigitalPin.P0, 0)" line26="        basic.pause(100)" line27="        pins.digitalWritePin(DigitalPin.P0, 1)" line28="" line29="    }" line30="    //% block='LED:$led R:$red G:$green B:$blue'" line31="    //% inlineInputMode=inline" line32="    //% red.defl=1" line33="    //% red.min=0 red.max=1" line34="    //% green.defl=1" line35="    //% green.min=0 green.max=1" line36="    //% blue.defl=1" line37="    //% blue.min=0 blue.max=1" line38="    //% group='RGB LED'" line39="    export function setLed(led: Led, red: number, green: number, blue: number) {" line40="        i2cWriteCommand(10, led as number, red, green, blue, 0, 0, 0);" line41="        let i2cReadBuffer = i2cReadCommand();" line42="        // return i2cReadBuffer.getNumber(NumberFormat.UInt8LE, 2);" line43="    }" line44="    //% block=&quot;Calibrate LF Sensors&quot;" line45="    //% group='Line Follower'" line46="    export function calibrateLfSensors() {" line47="        i2cWriteCommand(30, 1, 0, 0, 0, 0, 0, 0);" line48="        let i2cReadBuffer2 = i2cReadCommand();" line49="        // i2cReadCommand();" line50="    }" line51="    //% block=&quot;Read LF Sensors&quot;" line52="    //% group='Line Follower'" line53="    export function readLfSensors() {" line54="        i2cWriteCommand(30, 2, 0, 0, 0, 0, 0, 0);" line55="        let i2cReadBuffer3 = i2cReadCommand();" line56="        // return i2cReadBuffer[2];" line57="    }" line58="    //% block='Set Motor:$motor Dir:$dir Speed:$speed'" line59="    //% speed.defl=100" line60="    //% speed.min=0 speed.max=100" line61="    //% group='Moves'" line62="    export function setMotor(motor: Motor, dir: Dir, speed: number): void {" line63="        i2cWriteCommand(20, motor as number, speed, dir as number, 0, 0, 0, 0);" line64="    }" line65="    //% block = &quot;Stop Motors&quot;" line66="    //% group='Moves'" line67="    export function StopMotors() {" line68="        i2cWriteCommand(20, 2, 0, 0, 0, 0, 0, 0);" line69="    }" line70="    // note that Caml casing yields lower case" line71="    // block text with spaces" line72="    export function getRpAddress() {" line73="        let rp_address = 0x13;" line74="        return rp_address;" line75="    }" line76="    function i2cWriteCommand(commandId: number, subCommandId: number, arg1: number, arg2: number, arg3: number, arg4: number, arg5: number, arg6: number) {" line77="        let writeCommandBuffer = pins.createBuffer(8);" line78="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 0, commandId);" line79="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 1, subCommandId);" line80="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 2, arg1);" line81="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 3, arg2);" line82="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 4, arg3);" line83="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 5, arg4);" line84="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 6, arg5);" line85="        writeCommandBuffer.setNumber(NumberFormat.UInt8LE, 7, arg6);" line86="        pins.i2cWriteBuffer(getRpAddress(), writeCommandBuffer, false);" line87="    }" line88="    function i2cReadCommand() {" line89="        return pins.i2cReadBuffer(getRpAddress(), 8, false);" line90="    }" line91="}" numlines="92"></mutation></block></statement></block></xml>